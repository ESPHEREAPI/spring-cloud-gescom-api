              -> [basic-path] - `com.mproduits.model.Facture(f).dateFacture`
              :dateDebut
              :dateFin
            <- [is-between]
            -> [NOT_EQUAL]
                -> [basic-path] - `com.mproduits.model.Facture(f).statut`
            <- [NOT_EQUAL]
          <- [and]
        <- [where]
      <- [query-spec]
    <- [select]

